node_modules/
servers/node_modules/
servers/package-lock.json
*.log

# Everything under runs/ is ignored by default. Only the authoritative census
# is committed, by explicit exception below. Earlier runs are kept on disk but
# never published: census-v2 and census-v3 contain false positives that were
# later traced to the harness's own footprint, and shipping them alongside the
# corrected result would republish findings known to be wrong.
runs/*

!runs/census-v9/
runs/**/*.dt.jsonl
runs/**/census.json
runs/**/determinism/

scripts/candidates.raw.json
scripts/install.result.json

# Machine-specific: these carry absolute paths into this developer's home
# directory for every installed package. They are regenerated by `discover`,
# so publishing them would leak a local layout and buy nothing.
scripts/targets.auto.json
scripts/targets.auto.prev.json
scripts/targets.auto.prev2.json
scripts/targets.auto.stale.json
scripts/targets.smoke.json
